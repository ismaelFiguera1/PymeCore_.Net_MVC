@page
@model PymeCore.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split d-flex flex-column flex-md-row">
    <section class="auth-visual d-none d-md-flex flex-column justify-content-between p-5">
        <span class="fs-4 fw-semibold">PymeCore</span>
        <div class="auth-visual-caption">
            <h2 class="fw-bold">Gestiona tu empresa desde un solo lugar</h2>
            <p class="mb-0">Clientes, productos, pedidos y facturación en una única plataforma.</p>
        </div>
    </section>

    <section class="auth-form-panel d-flex align-items-center justify-content-center p-4">
        <div class="auth-form-wrapper">
            <header class="mb-4">
                <h1 class="h3 mb-1">Iniciar sesión</h1>
                <p class="text-muted mb-0">Accede a tu cuenta de PymeCore</p>
            </header>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe"></label>
                </div>
                <button id="login-submit" type="submit" class="btn btn-primary w-100">Iniciar sesión</button>

                <div class="text-center mt-3">
                    <p class="mb-1">
                        <a asp-area="Identity" asp-page="/Account/ForgotPassword">¿Has olvidado la contraseña?</a>
                    </p>
                    <p class="mb-1">
                        ¿No tienes cuenta?
                        <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate</a>
                    </p>
                    <p class="mb-0">
                        <a asp-area="Identity" asp-page="/Account/ResendEmailConfirmation">Reenviar correo de confirmación</a>
                    </p>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
