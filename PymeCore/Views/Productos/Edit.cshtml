@model PymeCore.ViewModels.Productos.ProductoFormViewModel

@{
    ViewData["Title"] = "Editar producto";
}

<article class="card" style="max-width: 600px;">
    <header class="card-header">
        <h2 class="card-title mb-0">Editar producto</h2>
    </header>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <section class="card-body">
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Sku" class="form-label"></label>
                <input asp-for="Sku" class="form-control" readonly />
            </div>
            <fieldset class="fieldset-group">
                <legend>Precios</legend>
                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="PrecioCoste" class="form-label"></label>
                        <input asp-for="PrecioCoste" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="PrecioCoste" class="text-danger small"></span>
                    </div>
                    <div class="col mb-3">
                        <label asp-for="PrecioVenta" class="form-label"></label>
                        <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>
            <fieldset class="fieldset-group">
                <legend>Stock</legend>
                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="StockActual" class="form-label"></label>
                        <input asp-for="StockActual" class="form-control" type="number" readonly />
                        <small class="text-muted">
                            El stock solo cambia mediante
                            <a asp-controller="MovimientoStock" asp-action="Index" asp-route-productoId="@Model.Id">movimientos</a>.
                        </small>
                    </div>
                    <div class="col mb-3">
                        <label asp-for="StockMinimo" class="form-label"></label>
                        <input asp-for="StockMinimo" class="form-control" type="number" min="0" />
                        <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>
            <div class="mb-3">
                <label asp-for="ProveedorId" class="form-label"></label>
                <select asp-for="ProveedorId" asp-items="ViewBag.Proveedores" class="form-select">
                    <option value="">— Selecciona un proveedor —</option>
                </select>
                <span asp-validation-for="ProveedorId" class="text-danger small"></span>
            </div>
        </section>
        <footer class="card-footer">
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-check-lg me-1"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
                <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
        </footer>
    </form>
</article>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
