@model PymeCore.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<article class="card" style="max-width: 600px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">@Model.Nombre</h2>
        @if (Model.BajoStock)
        {
            <span class="badge bg-danger">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Bajo stock
            </span>
        }
    </header>
    <section class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Referencia / SKU</dt>
            <dd class="col-sm-8"><code>@Model.Sku</code></dd>

            <dt class="col-sm-4">Precio de coste</dt>
            <dd class="col-sm-8">@Model.PrecioCoste.ToString("N2") €</dd>

            <dt class="col-sm-4">Precio de venta</dt>
            <dd class="col-sm-8">@Model.PrecioVenta.ToString("N2") €</dd>

            <dt class="col-sm-4">Stock actual</dt>
            <dd class="col-sm-8">
                @Model.StockActual unidades
                @if (Model.BajoStock)
                {
                    <span class="text-danger small">(mínimo: @Model.StockMinimo)</span>
                }
            </dd>

            <dt class="col-sm-4">Stock mínimo</dt>
            <dd class="col-sm-8">@Model.StockMinimo unidades</dd>

            <dt class="col-sm-4">Proveedor</dt>
            <dd class="col-sm-8">@(Model.Proveedor?.Nombre ?? "—")</dd>
        </dl>
    </section>
    <footer class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </footer>
</article>
