@model PymeCore.ViewModels.DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Resumen general";
    var culturaEs = CultureInfo.GetCultureInfo("es-ES");
}

<header class="mb-4">
    <h1 class="h3 mb-1">Resumen general</h1>
    <p class="text-muted mb-0">Situación actual de PymeCore</p>
</header>

<div class="row g-3">
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-2 text-primary">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h2 class="text-muted small mb-0">Clientes activos</h2>
                    <div class="fs-4 fw-bold">@Model.ClientesActivos</div>
                </div>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-2 text-warning">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h2 class="text-muted small mb-0">Stock bajo</h2>
                    <div class="fs-4 fw-bold">@Model.ProductosBajoStockTotal</div>
                </div>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-2 text-primary">
                    <i class="bi bi-file-text"></i>
                </div>
                <div>
                    <h2 class="text-muted small mb-0">Presupuestos pendientes</h2>
                    <div class="fs-4 fw-bold">@Model.PresupuestosEnviadosTotal</div>
                </div>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-2 text-danger">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h2 class="text-muted small mb-0">Facturas pendientes</h2>
                    <div class="fs-4 fw-bold">@Model.FacturasPendientesTotal &middot; @Model.FacturasPendientesImporteTotal.ToString("N2", culturaEs) €</div>
                </div>
            </div>
        </article>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <article class="card h-100">
            <header class="card-header d-flex align-items-center">
                <h2 class="fs-6 fw-normal mb-0"><i class="bi bi-box-seam me-1"></i> Productos con stock bajo</h2>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary btn-sm ms-auto">Ver todos</a>
            </header>
            <div class="card-body p-0">
                @if (!Model.ProductosBajoStock.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay productos con stock bajo.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Producto</th>
                                <th scope="col">SKU</th>
                                <th scope="col">Stock actual</th>
                                <th scope="col">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model.ProductosBajoStock)
                            {
                                var esCritico = producto.StockActual == 0;
                                <tr>
                                    <td>@producto.Nombre</td>
                                    <td><code>@producto.Sku</code></td>
                                    <td>@producto.StockActual</td>
                                    <td>
                                        @if (esCritico)
                                        {
                                            <span class="badge bg-danger">Crítico</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Bajo</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </article>
    </div>

    <div class="col-lg-6">
        <article class="card h-100">
            <header class="card-header d-flex align-items-center">
                <h2 class="fs-6 fw-normal mb-0"><i class="bi bi-cart me-1"></i> Últimos pedidos</h2>
                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-primary btn-sm ms-auto">Ver todos</a>
            </header>
            <div class="card-body p-0">
                @if (!Model.UltimosPedidos.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay pedidos registrados.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Pedido</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in Model.UltimosPedidos)
                            {
                                string badgeClass = pedido.Estado switch
                                {
                                    EstadoPedido.Pendiente     => "bg-warning text-dark",
                                    EstadoPedido.EnPreparacion => "bg-info",
                                    EstadoPedido.Completado    => "bg-success",
                                    EstadoPedido.Cancelado     => "bg-danger",
                                    _                          => "bg-secondary"
                                };
                                <tr>
                                    <td><code>@pedido.Numero</code></td>
                                    <td>@pedido.Cliente?.Nombre</td>
                                    <td><span class="badge @badgeClass">@pedido.Estado</span></td>
                                    <td class="text-end">@pedido.Total.ToString("N2", culturaEs) €</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </article>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <article class="card">
            <header class="card-header d-flex align-items-center">
                <h2 class="fs-6 fw-normal mb-0"><i class="bi bi-receipt me-1"></i> Facturas pendientes de cobro</h2>
                <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-primary btn-sm ms-auto">Ver todas</a>
            </header>
            <div class="card-body p-0">
                @if (!Model.FacturasPendientes.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay facturas pendientes de cobro.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Factura</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Fecha</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in Model.FacturasPendientes)
                            {
                                <tr>
                                    <td><code>@factura.Numero</code></td>
                                    <td>@factura.Cliente?.Nombre</td>
                                    <td>@factura.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-warning text-dark">@factura.Estado</span></td>
                                    <td class="text-end">@factura.Total.ToString("N2", culturaEs) €</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </article>
    </div>
</div>
