@model IEnumerable<PymeCore.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<article class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">Listado de clientes</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo cliente
        </a>
    </header>
    <section class="card-body border-bottom pb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="buscar" value="@ViewBag.Buscar"
                   class="form-control form-control-sm" placeholder="Buscar por nombre o NIF..." />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
            {
                <a asp-action="Index" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </section>
    <section class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Email</th>
                    <th scope="col">Teléfono</th>
                    <th scope="col">Ciudad</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr class="@(!cliente.Activo ? "table-secondary text-muted" : "")">
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Email</td>
                        <td>@cliente.Telefono</td>
                        <td>@(cliente.Ciudad ?? "—")</td>
                        <td>
                            @if (cliente.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (cliente.Activo)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDesactivarCliente"
                                        data-id="@cliente.Id"
                                        data-nombre="@cliente.Nombre">
                                    <i class="bi bi-person-x"></i>
                                </button>
                            }
                            else
                            {
                                <form asp-action="Activate" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-person-check"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</article>

<!-- Modal de confirmación -->
<div class="modal fade" id="modalDesactivarCliente" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <header class="modal-header">
                <h2 class="modal-title fs-6">Confirmar desactivación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </header>
            <section class="modal-body">
                ¿Desactivar a <strong id="modalNombreCliente"></strong>?
                <p class="text-muted small mb-0 mt-1">Esta acción se puede revertir editando el cliente.</p>
            </section>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <form id="formDesactivarCliente" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-person-x me-1"></i> Desactivar
                    </button>
                </form>
            </footer>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalDesactivarCliente').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('modalNombreCliente').textContent = btn.dataset.nombre;
            document.getElementById('formDesactivarCliente').action = '/Clientes/Deactivate/' + btn.dataset.id;
        });
    </script>
}
