@model PymeCore.Models.Cliente

@{
    ViewData["Title"] = "Ficha de cliente";
}

<article class="card" style="max-width: 600px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">@Model.Nombre</h2>
        @if (Model.Activo)
        {
            <span class="badge bg-success">Activo</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactivo</span>
        }
    </header>
    <address class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">NIF</dt>
                <dd class="col-sm-8">@Model.Nif</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@Model.Telefono</dd>

                <dt class="col-sm-4">Dirección</dt>
                <dd class="col-sm-8">@(Model.Direccion ?? "—")</dd>

                <dt class="col-sm-4">Ciudad</dt>
                <dd class="col-sm-8">@(Model.Ciudad ?? "—")</dd>
            </dl>
    </address>
    <footer class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </footer>
</article>
