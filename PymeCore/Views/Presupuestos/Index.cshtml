@model IEnumerable<PymeCore.Models.Presupuesto>

@{
    ViewData["Title"] = "Presupuestos";
}

@functions {
    static string BadgeEstado(PymeCore.Models.EstadoPresupuesto estado) => estado switch
    {
        PymeCore.Models.EstadoPresupuesto.Borrador  => "bg-secondary",
        PymeCore.Models.EstadoPresupuesto.Enviado   => "bg-info",
        PymeCore.Models.EstadoPresupuesto.Aceptado  => "bg-success",
        PymeCore.Models.EstadoPresupuesto.Rechazado => "bg-danger",
        _                                           => "bg-secondary"
    };
}

<article class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">Presupuestos</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo presupuesto
        </a>
    </header>
    <section class="card-body border-bottom pb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="buscar" value="@ViewBag.Buscar"
                   class="form-control form-control-sm" placeholder="Buscar por número o cliente..." />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
            {
                <a asp-action="Index" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </section>
    <section class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><code>@p.Numero</code></td>
                        <td>@p.Cliente?.Nombre</td>
                        <td>@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @BadgeEstado(p.Estado)">@p.Estado</span>
                        </td>
                        <td class="text-end">@p.Total.ToString("N2") €</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay presupuestos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</article>
