@model PymeCore.Models.Presupuesto
@using PymeCore.ViewModels.Presupuestos

@{
    ViewData["Title"] = Model.Numero;
    string badgeClass = Model.Estado switch
    {
        PymeCore.Models.EstadoPresupuesto.Borrador  => "bg-secondary",
        PymeCore.Models.EstadoPresupuesto.Enviado   => "bg-info",
        PymeCore.Models.EstadoPresupuesto.Aceptado  => "bg-success",
        PymeCore.Models.EstadoPresupuesto.Rechazado => "bg-danger",
        _                                           => "bg-secondary"
    };
    var lineaVm = ViewBag.LineaVm as LineaPresupuestoFormViewModel ?? new LineaPresupuestoFormViewModel();
}

<div class="card mb-3" style="max-width: 800px;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0"><code>@Model.Numero</code></h2>
        <span class="badge @badgeClass">@Model.Estado</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.Nombre</dd>

            <dt class="col-sm-4">Fecha</dt>
            <dd class="col-sm-8">@Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Observaciones</dt>
            <dd class="col-sm-8">@(Model.Observaciones ?? "—")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="card" style="max-width: 800px;">
    <div class="card-header">
        <h5 class="card-title mb-0">Líneas del presupuesto</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Lineas.Any())
        {
            <p class="text-muted p-3 mb-0">No hay líneas. Añade al menos una.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Descripción</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio unit.</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in Model.Lineas)
                    {
                        <tr>
                            <td>@linea.Producto?.Nombre</td>
                            <td>@(linea.Descripcion ?? "—")</td>
                            <td class="text-end">@linea.Cantidad</td>
                            <td class="text-end">@linea.PrecioUnitario.ToString("N2") €</td>
                            <td class="text-end">@linea.Subtotal.ToString("N2") €</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-danger btn-sm btn-eliminar-linea"
                                        data-linea-id="@linea.Id"
                                        data-presupuesto-id="@Model.Id"
                                        data-bs-toggle="modal" data-bs-target="#modalEliminarLinea">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end">Total</td>
                        <td class="text-end">@Model.Total.ToString("N2") €</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    <div class="card-footer">
        <h6 class="mb-3">Añadir línea</h6>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-1">@TempData["Error"]</div>
        }
        <form asp-action="AgregarLinea" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PresupuestoId" value="@Model.Id" />
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Producto</label>
                    <select name="ProductoId" id="selectProducto" class="form-select form-select-sm" required>
                        <option value="">— Selecciona —</option>
                        @foreach (var p in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Productos)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Descripción</label>
                    <input type="text" name="Descripcion" class="form-control form-control-sm" maxlength="200" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input type="number" name="Cantidad" id="inputCantidad" class="form-control form-control-sm"
                           value="1" min="1" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Precio unit.</label>
                    <input type="number" name="PrecioUnitario" id="inputPrecio" class="form-control form-control-sm"
                           step="0.01" min="0.01" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Subtotal</label>
                    <input type="text" id="inputSubtotal" class="form-control form-control-sm" readonly />
                </div>
            </div>
            <button type="submit" class="btn btn-success btn-sm mt-2">
                <i class="bi bi-plus-circle me-1"></i> Añadir línea
            </button>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEliminarLinea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar línea</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que quieres eliminar esta línea? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarLinea" asp-action="EliminarLinea" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="hiddenLineaId" name="lineaId" />
                    <input type="hidden" id="hiddenPresupuestoId" name="presupuestoId" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectProducto = document.getElementById('selectProducto');
        const inputPrecio    = document.getElementById('inputPrecio');
        const inputCantidad  = document.getElementById('inputCantidad');
        const inputSubtotal  = document.getElementById('inputSubtotal');

        selectProducto.addEventListener('change', async function () {
            const id = this.value;
            if (!id) { inputPrecio.value = ''; inputSubtotal.value = ''; return; }

            const res  = await fetch(`/Presupuestos/GetPrecioProducto?productoId=${id}`);
            const data = await res.json();
            inputPrecio.value = data.precio.toFixed(2);
            actualizarSubtotal();
        });

        function actualizarSubtotal() {
            const cant   = parseFloat(inputCantidad.value) || 0;
            const precio = parseFloat(inputPrecio.value)   || 0;
            inputSubtotal.value = (cant * precio).toFixed(2) + ' €';
        }

        inputCantidad.addEventListener('input', actualizarSubtotal);
        inputPrecio.addEventListener('input',   actualizarSubtotal);

        document.querySelectorAll('.btn-eliminar-linea').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('hiddenLineaId').value       = this.dataset.lineaId;
                document.getElementById('hiddenPresupuestoId').value = this.dataset.presupuestoId;
            });
        });
    </script>
}
