@model PymeCore.Models.Presupuesto

@{
    ViewData["Title"] = Model.Numero;
    string badgeClass = Model.Estado switch
    {
        PymeCore.Models.EstadoPresupuesto.Borrador  => "bg-secondary",
        PymeCore.Models.EstadoPresupuesto.Enviado   => "bg-info",
        PymeCore.Models.EstadoPresupuesto.Aceptado  => "bg-success",
        PymeCore.Models.EstadoPresupuesto.Rechazado => "bg-danger",
        _                                           => "bg-secondary"
    };
}

<article class="card" style="max-width: 600px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0"><code>@Model.Numero</code></h2>
        <span class="badge @badgeClass">@Model.Estado</span>
    </header>
    <section class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.Nombre</dd>

            <dt class="col-sm-4">Fecha</dt>
            <dd class="col-sm-8">@Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8"><span class="badge @badgeClass">@Model.Estado</span></dd>

            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8">
                @Model.Total.ToString("N2") €
                <small class="text-muted">(calculado desde las líneas)</small>
            </dd>

            <dt class="col-sm-4">Observaciones</dt>
            <dd class="col-sm-8">@(Model.Observaciones ?? "—")</dd>
        </dl>
    </section>
    <footer class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </footer>
</article>
