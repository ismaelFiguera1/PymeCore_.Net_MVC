@model PymeCore.Models.Presupuesto
@using PymeCore.Models

@{
    ViewData["Title"] = Model.Numero;
    bool puedeEditarLineas = Model.Estado == EstadoPresupuesto.Borrador;
}

@await Html.PartialAsync("Details/_Alertas")
@await Html.PartialAsync("Details/_PresupuestoCards", Model)
@await Html.PartialAsync("Details/_Modales", Model)

@section Scripts {
    @if (puedeEditarLineas)
    {
        <script>
            const selectProducto = document.getElementById('selectProducto');
            const inputPrecio    = document.getElementById('inputPrecio');
            const inputCantidad  = document.getElementById('inputCantidad');
            const inputSubtotal  = document.getElementById('inputSubtotal');

            selectProducto.addEventListener('change', async function () {
                const id = this.value;
                if (!id) { inputPrecio.value = ''; inputSubtotal.value = ''; return; }

                const res  = await fetch(`/Presupuestos/GetPrecioProducto?productoId=${id}`);
                const data = await res.json();
                inputPrecio.value = data.precio.toFixed(2);
                actualizarSubtotal();
            });

            function actualizarSubtotal() {
                const cant   = parseFloat(inputCantidad.value) || 0;
                const precio = parseFloat(inputPrecio.value)   || 0;
                inputSubtotal.value = (cant * precio).toFixed(2) + ' €';
            }

            inputCantidad.addEventListener('input', actualizarSubtotal);
            inputPrecio.addEventListener('input',   actualizarSubtotal);

            document.querySelectorAll('.btn-eliminar-linea').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('hiddenLineaId').value       = this.dataset.lineaId;
                    document.getElementById('hiddenPresupuestoId').value = this.dataset.presupuestoId;
                });
            });
        </script>
    }
}
