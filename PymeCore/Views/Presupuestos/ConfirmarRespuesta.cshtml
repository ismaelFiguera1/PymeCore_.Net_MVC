@model PymeCore.ViewModels.Presupuestos.RespuestaConfirmadaViewModel

@{
    ViewData["Title"] = "Respuesta registrada";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    var esAceptar = Model.Decision == "aceptar";
}

<div class="d-flex align-items-center justify-content-center py-5">
    <div class="w-100" style="max-width: 640px;">
        <article class="card">
            <section class="card-body text-center py-5">
                <i class="bi @(esAceptar ? "bi-check-circle text-success" : "bi-x-circle text-danger") fs-1"></i>
                <h1 class="h4 mt-3 mb-1">
                    Presupuesto <code>@Model.Numero</code> @(esAceptar ? "aceptado" : "rechazado")
                </h1>
                <p class="text-muted mb-0">Gracias por tu respuesta. Ya hemos registrado tu decisión.</p>
            </section>
        </article>
    </div>
</div>
