<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PymeCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/overlayscrollbars/styles/overlayscrollbars.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/admin-lte/dist/css/adminlte.min.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">

    <!-- Navbar -->
    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                        <i class="bi bi-list fs-5"></i>
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <partial name="_LoginPartial" />
            </ul>
        </div>
    </nav>

    <!-- Sidebar -->
    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-text fw-light">PymeCore</span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-speedometer2"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Clientes" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-people"></i>
                            <p>Clientes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Proveedores" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-truck"></i>
                            <p>Proveedores</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Productos" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-box-seam"></i>
                            <p>Productos</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Presupuestos" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-file-text"></i>
                            <p>Presupuestos</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Pedidos" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-cart"></i>
                            <p>Pedidos</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Facturas" asp-action="Index" class="nav-link">
                            <i class="nav-icon bi bi-receipt"></i>
                            <p>Facturas</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- Contenido principal -->
    <main class="app-main">
        <div class="app-content">
            <div class="container-fluid py-3">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <strong>&copy; 2026 PymeCore</strong>
    </footer>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/lib/overlayscrollbars/browser/overlayscrollbars.browser.es6.min.js" asp-append-version="true"></script>
<script src="~/lib/admin-lte/dist/js/adminlte.min.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
