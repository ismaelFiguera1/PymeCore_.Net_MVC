@model PymeCore.Models.Pedido
@using PymeCore.Models

@{
    ViewData["Title"] = Model.Numero;
    string badgeClass = Model.Estado switch
    {
        EstadoPedido.Pendiente     => "bg-warning text-dark",
        EstadoPedido.EnPreparacion => "bg-info",
        EstadoPedido.Completado    => "bg-success",
        EstadoPedido.Cancelado     => "bg-danger",
        _                          => "bg-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<article class="card mb-3" style="max-width: 800px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0"><code>@Model.Numero</code></h2>
        <span class="badge @badgeClass">@Model.Estado</span>
    </header>
    <section class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.Nombre</dd>

            <dt class="col-sm-4">Fecha</dt>
            <dd class="col-sm-8">@Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Presupuesto origen</dt>
            <dd class="col-sm-8">
                <a asp-controller="Presupuestos" asp-action="Details" asp-route-id="@Model.PresupuestoOrigenId">
                    @Model.PresupuestoOrigen?.Numero
                </a>
            </dd>

            <dt class="col-sm-4">Observaciones</dt>
            <dd class="col-sm-8">@(Model.Observaciones ?? "—")</dd>
        </dl>
    </section>
    <footer class="card-footer d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>

        @if (Model.Estado == EstadoPedido.Pendiente)
        {
            <form asp-action="CambiarEstado" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@EstadoPedido.EnPreparacion" />
                <button type="submit" class="btn btn-info btn-sm">
                    <i class="bi bi-play-circle me-1"></i> Iniciar preparación
                </button>
            </form>
            <form asp-action="CambiarEstado" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@EstadoPedido.Cancelado" />
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('¿Cancelar el pedido @Model.Numero?')">
                    <i class="bi bi-x-circle me-1"></i> Cancelar pedido
                </button>
            </form>
        }
        else if (Model.Estado == EstadoPedido.EnPreparacion)
        {
            <form asp-action="CambiarEstado" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@EstadoPedido.Completado" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-check-circle me-1"></i> Marcar como completado
                </button>
            </form>
            <form asp-action="CambiarEstado" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@EstadoPedido.Cancelado" />
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('¿Cancelar el pedido @Model.Numero?')">
                    <i class="bi bi-x-circle me-1"></i> Cancelar pedido
                </button>
            </form>
        }

        @if (Model.Estado == EstadoPedido.Completado && Model.FacturaId is null)
        {
            <form asp-controller="Facturas" asp-action="GenerarDesdePedido" method="post" class="d-inline">
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-receipt me-1"></i> Generar Factura
                </button>
            </form>
        }
        else if (Model.FacturaId is not null)
        {
            <a asp-controller="Facturas" asp-action="Details" asp-route-id="@Model.FacturaId" class="btn btn-outline-success btn-sm">
                <i class="bi bi-receipt me-1"></i> Ver Factura
            </a>
        }

    </footer>
</article>

<article class="card" style="max-width: 800px;">
    <header class="card-header">
        <h5 class="card-title mb-0">Líneas del pedido</h5>
    </header>
    <section class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-end">Cantidad</th>
                    <th scope="col" class="text-end">Precio unit.</th>
                    <th scope="col" class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in Model.Lineas)
                {
                    <tr>
                        <td>@linea.Producto?.Nombre</td>
                        <td>@(linea.Descripcion ?? "—")</td>
                        <td class="text-end">@linea.Cantidad</td>
                        <td class="text-end">@linea.PrecioUnitario.ToString("N2") €</td>
                        <td class="text-end">@linea.Subtotal.ToString("N2") €</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="4" class="text-end">Total</td>
                    <td class="text-end">@Model.Total.ToString("N2") €</td>
                </tr>
            </tfoot>
        </table>
    </section>
</article>
