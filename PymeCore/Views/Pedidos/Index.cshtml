@model IEnumerable<PymeCore.Models.Pedido>
@using PymeCore.Models

@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pedidos</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">No hay pedidos registrados. Los pedidos se crean desde presupuestos aceptados.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model)
                    {
                        string badgeClass = pedido.Estado switch
                        {
                            EstadoPedido.Pendiente     => "bg-warning text-dark",
                            EstadoPedido.EnPreparacion => "bg-info",
                            EstadoPedido.Completado    => "bg-success",
                            EstadoPedido.Cancelado     => "bg-danger",
                            _                          => "bg-secondary"
                        };
                        <tr>
                            <td><code>@pedido.Numero</code></td>
                            <td>@pedido.Cliente?.Nombre</td>
                            <td>@pedido.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @badgeClass">@pedido.Estado</span></td>
                            <td class="text-end">@pedido.Total.ToString("N2") €</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
