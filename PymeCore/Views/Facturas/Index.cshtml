@model IEnumerable<PymeCore.Models.Factura>
@using PymeCore.Models

@{
    ViewData["Title"] = "Facturas";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<article class="card">
    <header class="card-header">
        <h2 class="card-title mb-0">Facturas</h2>
    </header>
    <section class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">No hay facturas registradas. Las facturas se generan desde pedidos completados.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Número</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var factura in Model)
                    {
                        string badgeClass = factura.Estado switch
                        {
                            EstadoFactura.Pendiente => "bg-warning text-dark",
                            EstadoFactura.Pagada    => "bg-success",
                            EstadoFactura.Anulada   => "bg-danger",
                            _                       => "bg-secondary"
                        };
                        <tr>
                            <td><code>@factura.Numero</code></td>
                            <td>@factura.Cliente?.Nombre</td>
                            <td>@factura.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @badgeClass">@factura.Estado</span></td>
                            <td class="text-end">@factura.Total.ToString("N2") €</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@factura.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</article>
