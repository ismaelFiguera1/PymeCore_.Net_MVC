@model PymeCore.Models.Factura
@using PymeCore.Models

@{
    ViewData["Title"] = Model.Numero;
    string badgeClass = Model.Estado switch
    {
        EstadoFactura.Pendiente => "bg-warning text-dark",
        EstadoFactura.Pagada    => "bg-success",
        EstadoFactura.Anulada   => "bg-danger",
        _                       => "bg-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<article class="card mb-3" style="max-width: 800px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0"><code>@Model.Numero</code></h2>
        <span class="badge @badgeClass">@Model.Estado</span>
    </header>
    <section class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.Nombre</dd>

            <dt class="col-sm-4">Fecha de emisión</dt>
            <dd class="col-sm-8">@Model.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Pedido origen</dt>
            <dd class="col-sm-8">
                <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@Model.PedidoId">
                    @Model.Pedido?.Numero
                </a>
            </dd>

            <dt class="col-sm-4">Creada por</dt>
            <dd class="col-sm-8">@(Model.CreadoPorUsuario?.Email ?? "—")</dd>
        </dl>
    </section>
    <footer class="card-footer d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>

        <a asp-action="DescargarPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i> Descargar PDF
        </a>

        @if (Model.Estado == EstadoFactura.Pendiente)
        {
            <form asp-action="CambiarEstado" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@EstadoFactura.Pagada" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-check-circle me-1"></i> Marcar como pagada
                </button>
            </form>
            @if (User.IsInRole(PymeCore.Data.AppRoles.Administrador))
            {
                <form asp-action="CambiarEstado" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="nuevoEstado" value="@EstadoFactura.Anulada" />
                    <button type="submit" class="btn btn-outline-danger btn-sm"
                            onclick="return confirm('¿Anular la factura @Model.Numero?')">
                        <i class="bi bi-x-circle me-1"></i> Anular factura
                    </button>
                </form>
            }
        }
    </footer>
</article>

<article class="card" style="max-width: 800px;">
    <header class="card-header">
        <h5 class="card-title mb-0">Importes</h5>
    </header>
    <section class="card-body p-0">
        <table class="table table-sm mb-0">
            <tbody>
                <tr>
                    <td>Base imponible</td>
                    <td class="text-end">@Model.BaseImponible.ToString("N2") €</td>
                </tr>
                <tr>
                    <td>IVA (@Model.PorcentajeIVA.ToString("N0")%)</td>
                    <td class="text-end">@Model.TotalIVA.ToString("N2") €</td>
                </tr>
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td>Total</td>
                    <td class="text-end">@Model.Total.ToString("N2") €</td>
                </tr>
            </tfoot>
        </table>
    </section>
</article>
