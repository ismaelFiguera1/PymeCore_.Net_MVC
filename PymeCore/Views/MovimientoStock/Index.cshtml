@model List<PymeCore.Models.MovimientoStock>

@{
    var producto = (PymeCore.Models.Producto)ViewBag.Producto;
    ViewData["Title"] = $"Movimientos — {producto.Nombre}";
}

<article class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="card-title mb-0">Movimientos de stock</h2>
            <small class="text-muted">@producto.Nombre · Stock actual: <strong>@producto.StockActual unidades</strong></small>
        </div>
        <a asp-action="Create" asp-route-productoId="@producto.Id" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo movimiento
        </a>
    </header>

    @if (!Model.Any())
    {
        <section class="card-body">
            <p class="text-muted mb-0">No hay movimientos registrados para este producto.</p>
        </section>
    }
    else
    {
        <section class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    var (badgeClass, icono) = m.Tipo switch
                                    {
                                        PymeCore.Models.TipoMovimiento.Entrada    => ("bg-success", "bi-arrow-down-circle"),
                                        PymeCore.Models.TipoMovimiento.Salida     => ("bg-danger",  "bi-arrow-up-circle"),
                                        PymeCore.Models.TipoMovimiento.Devolucion => ("bg-info",    "bi-arrow-counterclockwise"),
                                        PymeCore.Models.TipoMovimiento.Ajuste     => ("bg-warning text-dark", "bi-sliders"),
                                        _                                          => ("bg-secondary", "bi-question")
                                    };
                                }
                                <span class="badge @badgeClass">
                                    <i class="bi @icono me-1"></i>@m.Tipo
                                </span>
                            </td>
                            <td>
                                @{
                                    // m.Cantidad es el número tal cual se guardó en la BD, SIEMPRE positivo
                                    // para Entrada/Salida/Devolucion (el formulario lo obliga), y puede ser
                                    // positivo o negativo solo para Ajuste (ej. -59 para restar 59 unidades).
                                    //
                                    // "valor" aquí representa el efecto REAL sobre el stock, no lo que se guardó:
                                    // - Si es Salida: aunque en BD esté guardado como positivo (ej. 16),
                                    //   el efecto siempre es restar, así que se le pone el signo "-" a mano (-m.Cantidad).
                                    // - Para el resto de tipos (Entrada, Devolucion, Ajuste): se deja tal cual
                                    //   está guardado, porque su signo ya es el correcto (Ajuste puede venir
                                    //   ya en negativo, y eso es justo lo que se quiere mostrar).
                                    var valor = m.Tipo == PymeCore.Models.TipoMovimiento.Salida ? -m.Cantidad : m.Cantidad;

                                    // A partir de "valor" (ya con el signo real) se decide qué símbolo mostrar:
                                    // "+" si es 0 o positivo, "-" si es negativo
                                    var signo = valor >= 0 ? "+" : "-";
                                }
                                @* Se muestra el símbolo calculado + el número en positivo (Math.Abs quita
                                   el signo del número para no duplicarlo, ya que el signo ya se puso arriba) *@
                                @signo@Math.Abs(valor)
                            </td>
                            <td>@(m.Motivo ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <footer class="card-footer">
        <a asp-controller="Productos" asp-action="Details" asp-route-id="@producto.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver al producto
        </a>
    </footer>
</article>
