@model PymeCore.Models.Proveedor

@{
    ViewData["Title"] = "Ficha de proveedor";
}

<article class="card" style="max-width: 600px;">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">@Model.Nombre</h2>
        @if (Model.Activo)
        {
            <span class="badge bg-success">Activo</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactivo</span>
        }
    </header>
    <section class="card-body">
        <address>
            <dl class="row mb-0">
                <dt class="col-sm-4">CIF</dt>
                <dd class="col-sm-8">@Model.Cif</dd>

                <dt class="col-sm-4">Persona de contacto</dt>
                <dd class="col-sm-8">@(Model.PersonaContacto ?? "—")</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
            </dl>
        </address>
    </section>
    <footer class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </footer>
</article>
